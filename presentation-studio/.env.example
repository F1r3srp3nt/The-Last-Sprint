# Presentation Studio — server configuration.
# Copy to .env (which is git-ignored) and fill in what you use. Every value is optional:
# with no keys the app runs in template mode with editing and PowerPoint export.
# Keys are read only by the local server. They are never sent to the browser,
# saved in project files or exports, or written to logs.

# --- Slide generation (Anthropic) -------------------------------------------
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# ANTHROPIC_REFUSAL_FALLBACK=default # set to "off" to disable the server-side refusal fallback
# GENERATION_PROVIDER=none           # force template-only mode even if a key is set

# --- Voice (ElevenLabs): spoken brief + slide narration ---------------------
# Create a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Server -----------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
